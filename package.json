{
  "name": "african-voices-backend",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
  "dev": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts next dev",
  "build": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload build",
  "start": "cross-env NODE_ENV=production cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts next start",
  "generate:types": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types"
},
  "dependencies": {
    "@payloadcms/db-postgres": "3.42.0",
    "@payloadcms/next": "3.42.0",
    "@payloadcms/payload-cloud": "3.42.0",
    "@payloadcms/plugin-search": "^3.42.0",
    "@payloadcms/richtext-lexical": "3.42.0",
    "@payloadcms/ui": "3.42.0",
    "cross-env": "^7.0.3",
    "csv-parser": "^3.2.0",
    "graphql": "^16.8.1",
    "json-2-csv": "^5.5.9",
    "next": "15.3.0",
    "payload": "3.42.0",
    "payload-oapi": "^0.2.3",
    "qs": "^6.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.32.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.5.4",
    "@types/qs": "^6.14.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.3.0",
    "prettier": "^3.4.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
